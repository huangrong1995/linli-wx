/* 首页：手机原生 —— 品牌行 + 悬浮搜索 + 头条卡 + 纵列表 */
.top {
  padding: 20rpx 24rpx 6rpx;
}
.brand-row {
  margin-bottom: 20rpx;
}
.brand {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.2;
}
.brand-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--muted);
}
.search-box {
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 0 26rpx;
  box-shadow: var(--shadow-soft);
}
.s-icon {
  color: var(--faint);
  font-size: 32rpx;
  margin-right: 14rpx;
}
.search {
  background: transparent;
  border: none;
  flex: 1;
  padding: 20rpx 0;
}
.search:focus {
  background: transparent;
  border: none;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  flex-shrink: 0;
}

/* 头条卡片：全出血，图片撑满 */
.hero {
  position: relative;
  margin: 10rpx 24rpx 0;
  height: 400rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-img.missing {
  background: linear-gradient(150deg, #E7F0EC, #D9E7E0);
}
.hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(180deg, rgba(20, 26, 24, 0) 0%, rgba(20, 26, 24, 0.72) 100%);
}
.hero-info {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 26rpx;
}
.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-price {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 纵列列表：原生一行一卡片 */
.list {
  padding: 0 24rpx 140rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--surface);
  border-radius: 26rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-soft);
  position: relative;
}
.row:active {
  transform: scale(0.99);
}
.row-media {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.row-img {
  width: 100%;
  height: 100%;
  display: block;
}
.row-img.missing {
  background: linear-gradient(150deg, #E7F0EC, #D9E7E0);
}
.row-body {
  flex: 1;
  min-width: 0;
}
.row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.row-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.borrow {
  color: var(--teal);
  font-weight: 650;
  font-size: 28rpx;
}
.fav {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-soft);
  color: var(--faint);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav.on {
  color: var(--teal);
}

/* 悬浮发布 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--teal);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 36rpx rgba(14, 122, 106, 0.4);
  z-index: 8;
}
.fab:active {
  transform: scale(0.94);
  opacity: 0.92;
}
.fab-plus {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.footer {
  text-align: center;
  color: var(--faint);
  padding: 24rpx;
  font-size: 24rpx;
}