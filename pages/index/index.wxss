/* 首页：OS 状态条 + 像素目录 */
.osbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--ink-2);
  border-bottom: 2rpx solid var(--line);
}
.os-l {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.os-mark {
  display: grid;
  grid-template-columns: 14rpx 14rpx;
  gap: 3rpx;
  width: 34rpx;
}
.mk {
  width: 14rpx;
  height: 14rpx;
}
.mk-blue { background: var(--blue); }
.mk-cyan { background: var(--cyan); }
.os-name {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--whit);
}
.os-ver {
  font-size: 20rpx;
  color: var(--steel);
}
.os-r {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.os-dot { color: var(--cyan); font-size: 18rpx; }
.os-status {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--steel);
}

.hero {
  padding: 30rpx 24rpx 6rpx;
}
.brand {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--whit);
  margin-bottom: 22rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: var(--navy);
  border: 2rpx solid var(--line);
  padding: 0 24rpx;
  box-shadow: 3rpx 3rpx 0 var(--pix);
}
.s-icon {
  color: var(--cyan);
  font-size: 26rpx;
  margin-right: 14rpx;
}
.search {
  background: transparent;
  border: none;
  box-shadow: none;
  flex: 1;
  padding: 20rpx 0;
}
.search:focus {
  background: transparent;
  border: none;
  box-shadow: none;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  flex-shrink: 0;
}

/* 双列像素网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 24rpx 150rpx;
}
.cell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--navy);
  border: 2rpx solid var(--line);
  padding: 14rpx;
  box-shadow: 4rpx 4rpx 0 var(--pix);
  position: relative;
  overflow: hidden;
}
.cell:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0 var(--pix);
}
.media {
  overflow: hidden;
}
.media-img {
  width: 100%;
  height: 280rpx;
  display: block;
}
.media-img.missing {
  background-color: var(--navy-2);
  background-image:
    repeating-linear-gradient(45deg,
      rgba(62, 123, 255, 0.08) 0 3rpx,
      transparent 3rpx 7rpx);
}
.cell-title {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--whit);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-foot {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.borrow {
  color: var(--cyan);
  font-weight: 700;
  font-size: 26rpx;
}
.fav {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(16, 19, 25, 0.7);
  border: 2rpx solid var(--line);
  color: var(--steel);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav.on {
  color: var(--cyan);
  border-color: var(--blue);
}

/* 悬浮发布：像素方块 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  background: var(--blue);
  border: 2rpx solid var(--line);
  box-shadow: 5rpx 5rpx 0 var(--pix);
  color: #101319;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 8;
}
.fab:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: 2rpx 2rpx 0 var(--pix);
}
.fab-plus {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: -4rpx;
}

.footer {
  text-align: center;
  color: var(--steel);
  padding: 24rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}