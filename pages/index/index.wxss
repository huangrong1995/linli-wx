/* 告示板头部：筛选 + 搜索 */
.board {
  background: linear-gradient(var(--forest), var(--forest));
  padding: 22rpx 24rpx 116rpx;
  margin-bottom: -84rpx;
}
.chips {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 6rpx;
}
.chip {
  flex-shrink: 0;
  background: rgba(255, 253, 246, 0.14);
  border-color: rgba(255, 253, 246, 0.22);
  color: #E7E2D2;
}
.chip.active {
  background: #F5F1E3;
  color: var(--forest);
  border-color: #F5F1E3;
}
.search-wrap {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  background: #FFFDF6;
  border-radius: 999rpx;
  padding: 0 26rpx;
}
.search-glyph {
  color: var(--muted);
  font-size: 34rpx;
  margin-right: 12rpx;
}
.search {
  background: transparent;
  border: none;
  flex: 1;
  padding: 18rpx 0;
}
.search:focus {
  border: none;
}

/* 纸签 */
.slip {
  display: flex;
  gap: 22rpx;
  align-items: stretch;
}
.slip-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.slip-thumb-empty {
  background: #EFE9D8;
  color: var(--faint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.slip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.slip-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.slip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slip-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.slip-owner {
  color: var(--muted);
  font-size: 22rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fav {
  color: var(--vermilion);
  font-size: 34rpx;
  line-height: 1;
  padding: 4rpx;
}
.footer {
  text-align: center;
  color: var(--muted);
  padding: 24rpx;
  font-size: 24rpx;
}