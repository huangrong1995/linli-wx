/* 首页：极光 + 悬浮搜索 + 玻璃网格 + 悬浮发布 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #EEF0F8 0%, var(--bg) 78%);
  padding-top: 30rpx;
}
.hero-inner {
  position: relative;
  padding: 6rpx 24rpx 20rpx;
}
.brand {
  display: block;
  margin-bottom: 26rpx;
}
.brand-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
  line-height: 1.15;
}
.brand-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 400;
  color: var(--ink-soft);
}

.search-box {
  display: flex;
  align-items: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
}
.s-icon {
  color: var(--ink-faint);
  font-size: 32rpx;
  margin-right: 14rpx;
}
.search {
  background: transparent;
  border: none;
  flex: 1;
  padding: 20rpx 0;
}
.search:focus {
  background: transparent;
  border: none;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  flex-shrink: 0;
}

/* 双列玻璃网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 24rpx 140rpx;
}
.cell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--glass);
  border: 1rpx solid var(--glass-line);
  border-radius: 26rpx;
  padding: 14rpx;
  box-shadow: var(--shadow-soft);
  background-image:
    linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 20%),
    linear-gradient(0deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.2));
  position: relative;
  overflow: hidden;
  transition: transform 0.12s;
}
.cell:active {
  transform: scale(0.975);
}
.media {
  border-radius: 18rpx;
  overflow: hidden;
}
.media-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.media-img.missing {
  background: linear-gradient(150deg, #EDEEF6, #E7E9F2);
}
.cell-title {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-foot {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.borrow {
  color: var(--accent);
  font-weight: 600;
  font-size: 26rpx;
}
.fav {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: var(--shadow-soft);
  color: var(--ink-faint);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav.on {
  color: var(--accent);
}

/* 悬浮发布：一键分享闲置 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--accent-grad);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(99, 102, 241, 0.4);
  z-index: 8;
}
.fab:active {
  transform: scale(0.94);
  opacity: 0.92;
}
.fab-plus {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.footer {
  text-align: center;
  color: var(--ink-faint);
  padding: 24rpx;
  font-size: 24rpx;
}