.topbar {
  background: var(--surface);
  padding: 16rpx 24rpx 20rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.search-box {
  display: flex;
  align-items: center;
  background: var(--canvas);
  border-radius: 999rpx;
  padding: 0 26rpx;
}
.s-icon {
  color: var(--ink-faint);
  font-size: 32rpx;
  margin-right: 14rpx;
}
.search {
  background: transparent;
  border: none;
  flex: 1;
  padding: 20rpx 0;
}
.search:focus {
  background: transparent;
  border: none;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  flex-shrink: 0;
}

/* 双列媒体网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
}
.cell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--surface);
  border-radius: 22rpx;
  padding: 14rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 6rpx 20rpx rgba(27, 42, 35, 0.05);
  position: relative;
  overflow: hidden;
}
.media {
  border-radius: 16rpx;
  overflow: hidden;
}
.media-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.media-img.missing {
  background: linear-gradient(135deg, #EDF0EB, #E3E8E2);
}
.cell-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-foot {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.borrow {
  color: var(--spruce);
  font-weight: 600;
  font-size: 26rpx;
}
.fav {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #C9CFCA;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav.on {
  color: var(--coral);
}
.footer {
  text-align: center;
  color: var(--ink-faint);
  padding: 24rpx;
  font-size: 24rpx;
}