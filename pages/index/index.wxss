/* 首页：入夜深色，顶部一抹窗灯 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #1E2B35 0%, var(--dusk) 100%);
  padding-top: 28rpx;
}
.hero-inner {
  position: relative;
  padding: 8rpx 24rpx 20rpx;
}
.brand {
  display: block;
  margin-bottom: 24rpx;
}
.brand-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  color: var(--plaster);
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.brand-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--moss);
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 0 26rpx;
}
.s-icon {
  color: var(--moss-soft);
  font-size: 32rpx;
  margin-right: 14rpx;
}
.search {
  background: transparent;
  border: none;
  flex: 1;
  padding: 20rpx 0;
}
.search:focus {
  background: transparent;
  border: none;
}
.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 4rpx;
}
.chip {
  flex-shrink: 0;
}

/* 双列媒体网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx 24rpx 8rpx;
}
.cell {
  width: calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  background: var(--panel);
  border-radius: 22rpx;
  padding: 14rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 8rpx 24rpx rgba(5, 10, 14, 0.35);
  position: relative;
  overflow: hidden;
}
.cell:active {
  background: var(--panel-2);
}
.media {
  border-radius: 16rpx;
  overflow: hidden;
}
.media-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.media-img.missing {
  background: linear-gradient(135deg, #27363F, #203038);
}
.cell-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--plaster);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cell-foot {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.borrow {
  color: var(--glow);
  font-weight: 650;
  font-size: 26rpx;
}
.fav {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(13, 20, 26, 0.6);
  border: 1rpx solid var(--line);
  color: var(--moss);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav.on {
  color: var(--glow);
  border-color: rgba(232, 163, 61, 0.5);
}
.footer {
  text-align: center;
  color: var(--moss-soft);
  padding: 24rpx;
  font-size: 24rpx;
}