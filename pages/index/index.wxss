.toolbar {
  background: #fff;
  padding: 16rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.tab {
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
}
.tab.active {
  background: #16a34a;
  color: #fff;
}
.search {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 28rpx;
}
.item {
  position: relative;
}
.item-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}
.price {
  color: #16a34a;
  font-weight: 600;
  margin-left: 16rpx;
}
.item-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.owner {
  color: #999;
  font-size: 24rpx;
}
.fav {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  color: #ef4444;
  font-size: 40rpx;
}
.footer {
  text-align: center;
  color: #999;
  padding: 24rpx;
}
