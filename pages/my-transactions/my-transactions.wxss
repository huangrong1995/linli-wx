.tabs {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 24rpx 0;
}
.tab-note {
  color: var(--steel);
  font-size: 23rpx;
  letter-spacing: 1rpx;
  padding: 16rpx 28rpx 4rpx;
}
.tx-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.tx-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--whit);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-type {
  color: var(--steel);
  font-size: 23rpx;
  flex-shrink: 0;
}
.tx-sub {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--whit);
  font-size: 26rpx;
}
.tx-peer {
  color: var(--steel);
  font-size: 23rpx;
  margin-left: auto;
}
.msg {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--navy-2);
  border: 2rpx solid var(--line);
  color: var(--steel);
  font-size: 25rpx;
}
.actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}
.btn-primary.mini, .btn-ghost.mini {
  margin: 0;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
}
.btn-primary.mini { box-shadow: 2rpx 2rpx 0 var(--pix); }
.btn-ghost.mini { box-shadow: 2rpx 2rpx 0 var(--pix); }