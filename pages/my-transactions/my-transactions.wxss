.tabs {
  display: flex;
  background: #fff;
  padding: 16rpx;
  gap: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 12rpx;
  color: #666;
}
.tab.active {
  background: #16a34a;
  color: #fff;
}
.row {
  font-size: 30rpx;
  font-weight: 600;
}
.row.sub {
  margin-top: 8rpx;
  color: #999;
  font-weight: 400;
  font-size: 26rpx;
}
.msg {
  margin-top: 12rpx;
  color: #666;
  font-size: 26rpx;
}
.actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}
