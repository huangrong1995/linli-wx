.tabs {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 24rpx 0;
}
.tab-note {
  color: var(--ink-soft);
  font-size: 24rpx;
  padding: 16rpx 28rpx 4rpx;
}
.tx-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.tx-title {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--ink);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tx-type {
  color: var(--ink-faint);
  font-size: 24rpx;
  flex-shrink: 0;
}
.tx-sub {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--ink);
  font-size: 26rpx;
}
.tx-peer {
  color: var(--ink-faint);
  font-size: 24rpx;
  margin-left: auto;
}
.msg {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 16rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}
.actions {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
  justify-content: flex-end;
}
.btn-primary.mini, .btn-ghost.mini {
  margin: 0;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}