.form {
  padding: 28rpx;
  margin-top: 24rpx;
}
.form .btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 10rpx;
}
.field {
  width: 100%;
  display: block;
  margin-bottom: 20rpx;
}
.field.tall {
  height: 180rpx;
}
.picker {
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  height: 96rpx;
}
.picker-row {
  display: flex;
  align-items: center;
  width: 100%;
}
.picker-label {
  color: var(--steel);
  font-size: 28rpx;
}
.picker-value {
  margin-left: 20rpx;
  color: var(--whit);
  font-size: 28rpx;
  font-weight: 600;
}
.arrow {
  margin-left: auto;
  color: var(--steel);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}
.img-field {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 228rpx;
  border: 2rpx dashed var(--line);
  background: var(--navy);
  box-shadow: 3rpx 3rpx 0 var(--pix);
  overflow: hidden;
  margin-bottom: 26rpx;
}
.img-preview {
  width: 100%;
  height: 100%;
}
.img-empty {
  color: var(--steel);
  font-size: 26rpx;
  letter-spacing: 1rpx;
}