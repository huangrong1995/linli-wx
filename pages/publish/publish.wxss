.form {
  padding: 28rpx;
  margin-top: 24rpx;
}
.form .btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 8rpx;
}
.field {
  width: 100%;
  display: block;
  margin-bottom: 20rpx;
}
.field.tall {
  height: 180rpx;
}
.picker {
  padding: 0 4rpx;
  display: flex;
  align-items: center;
  height: 96rpx;
}
.picker-row {
  display: flex;
  align-items: center;
  width: 100%;
}
.picker-label {
  color: var(--ink-soft);
  font-size: 28rpx;
}
.picker-value {
  margin-left: 20rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}
.arrow {
  margin-left: auto;
  color: var(--ink-faint);
  font-size: 40rpx;
  line-height: 1;
}
.img-field {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 224rpx;
  border: 2rpx dashed var(--line);
  background: var(--canvas);
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 26rpx;
}
.img-preview {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}
.img-empty {
  color: var(--ink-faint);
  font-size: 26rpx;
}