.form {
  padding: 28rpx;
}
.field {
  width: 100%;
  display: block;
  margin-bottom: 22rpx;
}
.field.tall {
  height: 180rpx;
}
.picker {
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  height: 92rpx;
}
.picker-row {
  display: flex;
  align-items: center;
  width: 100%;
}
.picker-label {
  color: var(--muted);
  font-size: 28rpx;
}
.picker-value {
  margin-left: 20rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
}
.arrow {
  margin-left: auto;
  color: var(--faint);
  font-size: 40rpx;
  line-height: 1;
}
.img-field {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  border: 2rpx dashed rgba(31, 59, 49, 0.3);
  background: #F4F0E1;
  overflow: hidden;
}
.img-preview {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.img-empty {
  color: var(--muted);
  font-size: 26rpx;
}