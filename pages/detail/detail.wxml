<view class="page">
  <view class="card sheet">
    <image wx:if="{{item.image}}" class="hero" src="{{item.image}}" mode="aspectFill" />
    <view class="head">
      <text class="title">{{item.title}}</text>
      <text class="tag">{{typeLabel[item.item_type]}}</text>
    </view>
    <view class="price-band">
      <text class="price" wx:if="{{item.item_type!=='lend'}}">¥{{item.price}}</text>
      <text class="borrow" wx:else>免费借用</text>
      <text class="tag {{item.status==='available'?'':'tag-warn'}}">{{statusLabel[item.status]}}</text>
    </view>

    <view class="divider"></view>
    <view class="desc">{{item.description}}</view>

    <view class="divider"></view>
    <view class="spec">
      <view class="spec-row"><text class="spec-k">邻里</text><text class="spec-v">{{item.owner.community}}{{item.owner.building}}栋{{item.owner.room}} · {{item.owner.username}}</text></view>
      <view class="spec-row"><text class="spec-k">电话</text><text class="spec-v">{{item.contact_phone}}</text></view>
    </view>
  </view>
  <view class="spacer"></view>
</view>

<view class="actionbar">
  <button class="btn-ghost act" wx:if="{{!item.is_owner}}" bindtap="onFavTap">{{item.is_favorited?'已收藏':'收藏'}}</button>
  <button class="btn-primary act" wx:if="{{!item.is_owner}}" bindtap="onTransTap">发起交易</button>
</view>

<view class="mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-title">给邻里的留言</view>
  <textarea placeholder="给主人留言（可选）" value="{{message}}" bindinput="onMessage" />
  <button class="btn-primary" bindtap="submitTrans">送出请求</button>
  <button class="btn-ghost" bindtap="hideModal">取消</button>
</view>