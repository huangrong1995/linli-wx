.pic image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 600;
}
.row {
  margin-top: 12rpx;
  color: #555;
}
.desc {
  margin-top: 16rpx;
  color: #333;
  line-height: 1.6;
}
.owner {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
  color: #666;
  line-height: 1.6;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 30%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 11;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.modal textarea {
  width: 100%;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
