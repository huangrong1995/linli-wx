.sheet {
  margin: 24rpx 24rpx 0;
  padding: 0;
  border-width: 2rpx;
}
.hero {
  width: 100%;
  height: 440rpx;
  display: block;
  background-color: var(--navy-2);
  background-image:
    repeating-linear-gradient(45deg,
      rgba(95, 212, 226, 0.06) 0 3rpx,
      transparent 3rpx 7rpx);
}
.head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}
.head .tag {
  flex-shrink: 0;
  margin-top: 6rpx;
}
.title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--whit);
  line-height: 1.4;
}
.price-band {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx 2rpx;
}
.borrow {
  color: var(--cyan);
  font-weight: 700;
  font-size: 32rpx;
}
.divider {
  height: 2rpx;
  background: var(--line);
  margin: 24rpx 28rpx;
}
.desc {
  padding: 0 28rpx;
  color: var(--whit);
  line-height: 1.8;
  font-size: 28rpx;
}
.spec {
  padding: 0 28rpx 28rpx;
}
.spec-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 10rpx 0;
}
.spec-k {
  font-size: 23rpx;
  color: var(--cyan);
  letter-spacing: 1rpx;
  width: 72rpx;
}
.spec-v {
  flex: 1;
  color: var(--steel);
  font-size: 26rpx;
}

/* 悬浮像素操作栏 */
.spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}
.actionbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  background: var(--ink-2);
  border: 2rpx solid var(--line);
  box-shadow: 4rpx 4rpx 0 var(--pix);
  z-index: 6;
}
.act {
  flex: 1;
  margin-top: 0;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  box-shadow: 3rpx 3rpx 0 var(--pix);
}
.act.btn-primary { flex: 1.5; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(8, 11, 16, 0.72);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  top: 30%;
  background: var(--navy);
  border: 2rpx solid var(--line);
  padding: 32rpx;
  z-index: 11;
  box-shadow: 6rpx 6rpx 0 var(--pix);
}
.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
  color: var(--cyan);
}
.modal textarea {
  height: 170rpx;
  background: var(--navy-2);
}