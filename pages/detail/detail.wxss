.sheet {
  margin: 24rpx;
  overflow: hidden;
  padding: 0;
}
.hero {
  width: 100%;
  height: 420rpx;
  display: block;
}
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
}
.price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx 0;
}
.price-tag {
  color: var(--vermilion);
  font-size: 40rpx;
  font-weight: 700;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
.borrow-note {
  color: var(--stem);
  font-size: 30rpx;
  font-weight: 600;
}
.desc {
  padding: 24rpx 28rpx;
  color: var(--ink);
  line-height: 1.7;
  font-size: 28rpx;
}
.owner {
  margin: 0 28rpx 24rpx;
  padding: 22rpx 24rpx;
  background: #F4F0E1;
  border-radius: 10rpx;
}
.owner-line {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.8;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(22, 44, 36, 0.5);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 26%;
  background: var(--card);
  border-radius: 16rpx;
  padding: 36rpx;
  z-index: 11;
  box-shadow: 0 12rpx 40rpx rgba(22, 44, 36, 0.25);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--ink);
}
.modal textarea {
  width: 100%;
  height: 180rpx;
  margin-bottom: 12rpx;
}
.modal .btn-ghost {
  margin-top: 16rpx;
}