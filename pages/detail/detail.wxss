.sheet {
  margin: 24rpx 24rpx 0;
  padding: 0;
  overflow: hidden;
  border-radius: 34rpx;
}
.hero {
  width: 100%;
  height: 460rpx;
  display: block;
  background: linear-gradient(150deg, #EDEEF6, #E7E9F2);
}
.head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 30rpx 30rpx 0;
}
.head .tag {
  flex-shrink: 0;
  margin-top: 8rpx;
}
.title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  color: var(--ink);
  line-height: 1.35;
}
.price-band {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 30rpx 4rpx;
}
.borrow {
  color: var(--accent);
  font-weight: 600;
  font-size: 34rpx;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 30rpx;
}
.desc {
  padding: 0 30rpx;
  color: var(--ink);
  line-height: 1.75;
  font-size: 28rpx;
  font-weight: 400;
}
.spec {
  padding: 0 30rpx 30rpx;
}
.spec-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 10rpx 0;
}
.spec-k {
  font-size: 24rpx;
  color: var(--ink-faint);
  width: 72rpx;
}
.spec-v {
  flex: 1;
  color: var(--ink-soft);
  font-size: 27rpx;
}

/* 悬浮玻璃操作栏 */
.spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}
.actionbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  background: var(--glass-strong);
  border: 1rpx solid var(--glass-line);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  z-index: 6;
}
.act {
  flex: 1;
  margin-top: 0;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 999rpx;
}
.act.btn-primary { flex: 1.5; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 22, 29, 0.4);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 30%;
  background: var(--surface);
  border-radius: 30rpx;
  padding: 36rpx;
  z-index: 11;
  box-shadow: var(--shadow);
}
.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--ink);
}
.modal textarea {
  height: 170rpx;
  margin-bottom: 8rpx;
}