.sheet {
  margin: 24rpx 24rpx 0;
  padding: 0;
  overflow: hidden;
  border-radius: 32rpx;
}
.hero {
  width: 100%;
  height: 480rpx;
  display: block;
  background: linear-gradient(150deg, #E7F0EC, #D9E7E0);
}
.head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}
.head .tag {
  flex-shrink: 0;
  margin-top: 6rpx;
}
.title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
}
.price-band {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx 4rpx;
}
.borrow {
  color: var(--teal);
  font-weight: 650;
  font-size: 34rpx;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 28rpx;
}
.desc {
  padding: 0 28rpx;
  color: var(--ink);
  line-height: 1.75;
  font-size: 28rpx;
}
.spec {
  padding: 0 28rpx 28rpx;
}
.spec-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 10rpx 0;
}
.spec-k {
  font-size: 24rpx;
  color: var(--faint);
  width: 72rpx;
}
.spec-v {
  flex: 1;
  color: var(--muted);
  font-size: 27rpx;
}

/* 吸底操作栏 */
.spacer {
  height: calc(170rpx + env(safe-area-inset-bottom));
}
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  z-index: 5;
}
.act {
  flex: 1;
  margin-top: 0;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
}
.act.btn-primary { flex: 1.5; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(34, 38, 42, 0.45);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 28%;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 36rpx;
  z-index: 11;
  box-shadow: var(--shadow);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
  color: var(--ink);
}
.modal textarea {
  height: 180rpx;
  margin-bottom: 8rpx;
}