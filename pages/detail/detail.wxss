.sheet {
  margin: 24rpx 24rpx 0;
  padding: 0;
  overflow: hidden;
}
.hero {
  width: 100%;
  height: 440rpx;
  display: block;
  background: linear-gradient(135deg, #27363F, #203038);
}
.head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 28rpx 0;
}
.head .tag {
  flex-shrink: 0;
  margin-top: 8rpx;
}
.title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--plaster);
  line-height: 1.35;
}
.price-band {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx 4rpx;
}
.borrow {
  color: var(--glow);
  font-weight: 700;
  font-size: 34rpx;
}
.divider {
  height: 1rpx;
  background: var(--line-soft);
  margin: 24rpx 28rpx;
}
.desc {
  padding: 0 28rpx;
  color: var(--plaster);
  line-height: 1.75;
  font-size: 28rpx;
}
.spec {
  padding: 0 28rpx 28rpx;
}
.spec-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 10rpx 0;
}
.spec-k {
  font-size: 24rpx;
  color: var(--moss);
  width: 72rpx;
}
.spec-v {
  flex: 1;
  color: var(--moss);
  font-size: 27rpx;
}

/* 底部吸底操作栏 */
.spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}
.actionbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(27, 39, 48, 0.94);
  border-top: 1rpx solid var(--line-soft);
  z-index: 5;
}
.act {
  flex: 1;
  margin-top: 0;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
}
.act.btn-primary { flex: 1.4; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(5, 10, 14, 0.6);
  z-index: 10;
}
.modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 26%;
  background: var(--panel);
  border-radius: 24rpx;
  padding: 36rpx;
  z-index: 11;
  box-shadow: 0 16rpx 48rpx rgba(5, 10, 14, 0.6);
  border: 1rpx solid var(--line);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
  color: var(--plaster);
}
.modal textarea {
  height: 180rpx;
  margin-bottom: 8rpx;
}