.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 24rpx 20rpx;
  padding: 30rpx 28rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--glow-soft);
  border: 1rpx solid rgba(232, 163, 61, 0.4);
  color: var(--glow);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.profile-body {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--plaster);
}
.meta {
  margin-top: 6rpx;
  color: var(--moss);
  font-size: 26rpx;
}

.group {
  margin: 0 24rpx 24rpx;
  padding: 0 28rpx;
}
.menu {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  color: var(--plaster);
  font-size: 30rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.menu.last {
  border-bottom: none;
}
.menu:active {
  opacity: 0.6;
}
.arrow {
  margin-left: auto;
  color: var(--moss-soft);
  font-size: 40rpx;
  line-height: 1;
}
.badge {
  margin-left: 12rpx;
  background: var(--glow);
  color: #1B2730;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.btn-primary {
  margin: 8rpx 24rpx 40rpx;
  height: 96rpx;
  line-height: 96rpx;
}