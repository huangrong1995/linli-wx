.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 24rpx 20rpx;
  padding: 30rpx 28rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.profile-body {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.meta {
  margin-top: 6rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.group {
  margin: 0 24rpx 24rpx;
  padding: 0 28rpx;
}
.menu {
  position: relative;
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 400;
  border-bottom: 1rpx solid var(--line-soft);
}
.menu.last {
  border-bottom: none;
}
.menu:active {
  opacity: 0.55;
}
.arrow {
  margin-left: auto;
  color: var(--ink-faint);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}
.badge {
  margin-left: 12rpx;
  background: var(--accent-grad);
  color: #FFF;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.btn-primary {
  margin: 8rpx 24rpx 40rpx;
  height: 96rpx;
  line-height: 96rpx;
}