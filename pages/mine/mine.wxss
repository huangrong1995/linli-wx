.profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 24rpx 20rpx;
  padding: 30rpx 28rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--blue);
  border: 2rpx solid var(--line);
  box-shadow: 3rpx 3rpx 0 var(--pix);
  color: #101319;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.profile-body {
  flex: 1;
  min-width: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--whit);
}
.meta {
  margin-top: 6rpx;
  color: var(--steel);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.group {
  margin: 0 24rpx 24rpx;
  padding: 0 28rpx;
}
.menu {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  color: var(--whit);
  font-size: 29rpx;
  font-weight: 500;
  border-bottom: 2rpx solid var(--line);
}
.menu.last {
  border-bottom: none;
}
.menu:active {
  color: var(--cyan);
  background: rgba(62, 123, 255, 0.08);
}
.arrow {
  margin-left: auto;
  color: var(--steel);
  font-size: 40rpx;
  line-height: 1;
  font-weight: 300;
}
.badge {
  margin-left: 12rpx;
  background: var(--blue);
  color: #101319;
  font-size: 20rpx;
  line-height: 1;
  padding: 6rpx 12rpx;
  border: 2rpx solid var(--line);
  font-weight: 700;
}

.btn-primary {
  margin: 8rpx 24rpx 40rpx;
  height: 96rpx;
  line-height: 96rpx;
}