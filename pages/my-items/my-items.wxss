.slip {
  display: flex;
  gap: 22rpx;
  align-items: stretch;
}
.slip-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.slip-thumb-empty {
  background: #EFE9D8;
  color: var(--faint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.slip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.slip-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.slip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slip-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.btn-ghost.mini {
  margin: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
}