.slip {
  display: flex;
  gap: 22rpx;
  border-width: 2rpx;
}
.slip-thumb {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
  background-color: var(--navy-2);
  background-image:
    repeating-linear-gradient(45deg,
      rgba(62, 123, 255, 0.08) 0 3rpx,
      transparent 3rpx 7rpx);
}
.slip-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--steel);
}
.slip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  height: 150rpx;
  padding: 6rpx 0;
}
.slip-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.slip-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--whit);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slip-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.btn-ghost.mini {
  margin: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: var(--steel);
  box-shadow: 2rpx 2rpx 0 var(--pix);
}