<view wx:for="{{items}}" wx:key="id" class="card" bindtap="onItemTap" data-id="{{item.id}}">
  <view class="row">{{item.title}}</view>
  <view class="row sub">状态：{{statusLabel[item.status]}} · {{item.item_type==='lend' ? '借用' : '¥'+item.price}}</view>
  <button size="mini" catchtap="onDelete" data-id="{{item.id}}">删除</button>
</view>
<view class="empty" wx:if="{{items.length===0}}">还没有发布物品</view>
