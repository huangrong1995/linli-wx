.slip {
  display: flex;
  gap: 22rpx;
  align-items: center;
}
.slip-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(150deg, #E7F0EC, #D9E7E0);
}
.slip-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--faint);
}
.slip-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  height: 150rpx;
  padding: 6rpx 0;
}
.slip-top {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.slip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.slip-note {
  color: var(--teal);
  font-size: 26rpx;
  font-weight: 650;
}
.slip-act {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.btn-ghost.mini {
  margin: 0;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  color: var(--muted);
}