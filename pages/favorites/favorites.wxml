<view wx:for="{{items}}" wx:key="id" class="card" bindtap="onItemTap" data-id="{{item.id}}">
  <view class="row">{{item.title}}</view>
  <view class="row sub">{{item.item_type==='lend' ? '借用' : '¥'+item.price}}</view>
  <button size="mini" catchtap="onUnfav" data-id="{{item.id}}">取消收藏</button>
</view>
<view class="empty" wx:if="{{items.length===0}}">还没有收藏的物品</view>
