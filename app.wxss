/* ===== 当代邻里 · 设计系统 =====
 * 现代明亮移动风格：中性画布 + 白卡片 + 克制深绿品牌色 + 珊瑚价签
 * 圆角分层：媒体大圆角 / 卡片中圆角 / 控件胶囊
 */
page {
  --canvas: #F5F6F2;
  --surface: #FFFFFF;
  --ink: #1B2A23;
  --ink-soft: #66746C;
  --ink-faint: #A6AEA8;
  --line: rgba(27, 42, 35, 0.08);
  --line-soft: rgba(27, 42, 35, 0.05);
  --spruce: #0E6B46;
  --spruce-strong: #0A5137;
  --tint: rgba(14, 107, 70, 0.09);
  --coral: #D4512C;

  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

/* 白卡片：细描边 + 柔影，悬浮于画布 */
.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  border: 1rpx solid var(--line-soft);
  box-shadow: 0 6rpx 24rpx rgba(27, 42, 35, 0.05);
  position: relative;
}

/* 价格：珊瑚，单点强调 */
.price {
  color: var(--coral);
  font-weight: 650;
  font-size: 34rpx;
  letter-spacing: 0.5rpx;
}
.price-small {
  color: var(--coral);
  font-weight: 650;
  font-size: 30rpx;
}

/* 状态盖戳：浅色填充 + 描边 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--tint);
  color: var(--spruce);
}
.tag-warn {
  background: rgba(212, 81, 44, 0.1);
  color: var(--coral);
}
.tag-muted {
  background: rgba(102, 116, 108, 0.12);
  color: var(--ink-soft);
}

/* 筛选片 */
.chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  transition: all 0.2s;
}
.chip.active {
  background: var(--spruce);
  color: #FFFFFF;
  border-color: var(--spruce);
  font-weight: 600;
}

/* 主按钮：胶囊，品牌绿 */
.btn-primary {
  background: var(--spruce);
  color: #FFFFFF;
  border-radius: 999rpx;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary::after {
  border: none;
}
.btn-primary:active {
  background: var(--spruce-strong);
}

/* 次要按钮：白底描边 */
.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-ghost::after {
  border: none;
}

/* 输入：圆角字段，浅底色 */
input, textarea {
  background: var(--canvas);
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
  width: 100%;
}
input:focus, textarea:focus {
  background: var(--surface);
  border-color: var(--spruce);
}

/* 空态：邀请动作 */
.empty {
  text-align: center;
  color: var(--ink-soft);
  padding: 90rpx 48rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.empty .empty-title {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* 区块标题：左对齐、绿点锚定 */
.section-title {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--ink);
  margin: 28rpx 24rpx 16rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-title::before {
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--spruce);
}