/* ===== 邻里 OS · 像素设计系统 =====
 * 一台由像素构成的现代操作系统。
 * 硬边、零圆角、偏移像素影、抖点代替渐变、有限色板。
 * 字号里拉丁/数字走等宽，中文走系统黑体 —— 终端质感，中文可读。
 * 全局：无圆角、无模糊渐影、无抗锯齿假影。
 */
page {
  --ink:   #101319;   /* deep charcoal · 页面底 */
  --ink-2: #151A24;
  --navy:  #1B2334;   /* dark navy · 面板 */
  --navy-2:#263049;
  --blue:  #3E7BFF;   /* electric blue · 主强调 */
  --cyan:  #5FD4E2;   /* soft cyan · 次强调 */
  --whit:  #F2EFE8;   /* warm white · 前景 */
  --steel: #8A93A8;   /* steel · 次要文字 */
  --line:  #2A3144;   /* 硬像素描边 */
  --pix:   #080B10;   /* 像素影（硬偏移） */

  background: var(--ink);
  color: var(--whit);
  font-size: 28rpx;
  font-family: Menlo, Consolas, "SF Mono", "Courier New", "PingFang SC", monospace;
  font-weight: 400;
  line-height: 1.6;
}

/* 全局：无圆角 —— 像素铁律 */
page, view, text, button, input, textarea, picker, image, navigator {
  border-radius: 0;
}

/* 面板：深海军蓝，双像素描边，硬偏移影 */
.card {
  background: var(--navy);
  border: 2rpx solid var(--line);
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 4rpx 4rpx 0 var(--pix);
  position: relative;
}

/* 抖点遮罩：图块或状态条里代替渐变的细密像素点 */
.dither {
  background-image:
    repeating-linear-gradient(45deg,
      rgba(242, 239, 232, 0.05) 0 3rpx,
      transparent 3rpx 7rpx);
}

/* 价格：电光蓝 */
.price {
  color: var(--blue);
  font-weight: 700;
  font-size: 34rpx;
  letter-spacing: 1rpx;
}
.price-small {
  color: var(--blue);
  font-weight: 700;
  font-size: 30rpx;
}

/* 状态戳：硬像素标签 */
.tag {
  display: inline-block;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  padding: 8rpx 12rpx;
  border: 2rpx solid var(--blue);
  color: var(--cyan);
  background: rgba(62, 123, 255, 0.14);
}
.tag-warn {
  border-color: #E07A54;
  color: #F0A88B;
  background: rgba(224, 122, 84, 0.12);
}
.tag-muted {
  border-color: var(--line);
  color: var(--steel);
  background: transparent;
}

/* 筛选片：像素切换钮 */
.chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  border: 2rpx solid var(--line);
  background: var(--navy);
  color: var(--steel);
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.12s;
}
.chip.active {
  border-color: var(--blue);
  background: var(--blue);
  color: #101319;
  font-weight: 700;
}

/* 主按钮：电光蓝填充 + 像素影 */
.btn-primary {
  background: var(--blue);
  color: #101319;
  border: 2rpx solid var(--line);
  border-radius: 0;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 4rpx 4rpx 0 var(--pix);
}
.btn-primary::after {
  border: none;
}
.btn-primary:active {
  color: var(--cyan);
  box-shadow: 1rpx 1rpx 0 var(--pix);
  transform: translate(3rpx, 3rpx);
}

/* 次要按钮：描边 */
.btn-ghost {
  background: var(--navy);
  color: var(--whit);
  border: 2rpx solid var(--line);
  border-radius: 0;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 3rpx 3rpx 0 var(--pix);
}
.btn-ghost::after {
  border: none;
}
.btn-ghost:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 1rpx 1rpx 0 var(--pix);
}

/* 输入：硬像素字段 */
input, textarea {
  background: var(--navy);
  border: 2rpx solid var(--line);
  border-radius: 0;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--whit);
  box-sizing: border-box;
  width: 100%;
  font-weight: 400;
}
input::placeholder, textarea::placeholder {
  color: var(--steel);
}
input:focus, textarea:focus {
  border-color: var(--blue);
  background: var(--navy-2);
}

/* 空态 */
.empty {
  text-align: center;
  color: var(--steel);
  padding: 100rpx 52rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
.empty .empty-title {
  display: block;
  color: var(--whit);
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

/* 区块标题：等宽、左上锚定 */
.section-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--cyan);
  text-transform: uppercase;
  margin: 30rpx 28rpx 18rpx;
}
.section-title::after {
  content: "▍";
  color: var(--blue);
  margin-left: 8rpx;
}