page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}
.btn-primary {
  background: #16a34a;
  color: #fff;
  border-radius: 12rpx;
  margin-top: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
}
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #ecfdf5;
  color: #16a34a;
  margin-right: 12rpx;
}