/* ===== 邻里闲置 · 轻社区设计系统 =====
 * 干净现代、手机原生：通透浅底 + 纯白卡片 + 单一青绿强调。
 * 少即是多：一个强调色用于价格与主操作，其余靠中性层级与留白。
 * 记忆点：首页的全出血头条卡片 —— 一眼看见今天最值得的闲置。
 */
page {
  --bg: #F5F6F5;
  --surface: #FFFFFF;
  --ink: #22262A;
  --muted: #767D82;
  --faint: #A9B0B5;
  --line: #EDEFED;
  --line-soft: rgba(34, 38, 42, 0.06);
  --teal: #0E7A6A;
  --teal-deep: #0A5E52;
  --teal-soft: rgba(14, 122, 106, 0.08);
  --shadow: 0 10rpx 32rpx rgba(34, 38, 42, 0.07);
  --shadow-soft: 0 4rpx 16rpx rgba(34, 38, 42, 0.05);

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

/* 白卡片：一层悬浮，无边框靠影 */
.card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: var(--shadow-soft);
  position: relative;
}

/* 价格：青绿，单点强调 */
.price {
  color: var(--teal);
  font-weight: 650;
  font-size: 34rpx;
  letter-spacing: 0.5rpx;
}
.price-small {
  color: var(--teal);
  font-weight: 650;
  font-size: 30rpx;
}

/* 状态盖戳：浅青底 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--teal-soft);
  color: var(--teal);
}
.tag-warn {
  background: rgba(216, 106, 74, 0.1);
  color: #D0623F;
}
.tag-muted {
  background: rgba(118, 125, 130, 0.12);
  color: var(--muted);
}
/* 盖戳之白字版：压在图片上时 */
.tag.light {
  background: rgba(255, 255, 255, 0.9);
  color: var(--teal);
}

/* 筛选片 */
.chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--muted);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  transition: all 0.2s;
}
.chip.active {
  background: var(--teal);
  color: #FFFFFF;
  border-color: var(--teal);
  font-weight: 600;
}

/* 主按钮：青绿胶囊 */
.btn-primary {
  background: var(--teal);
  color: #FFFFFF;
  border-radius: 999rpx;
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary::after {
  border: none;
}
.btn-primary:active {
  background: var(--teal-deep);
}

/* 次要按钮：白底描边 */
.btn-ghost {
  background: var(--surface);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-ghost::after {
  border: none;
}

/* 输入：圆角字段，浅底色 */
input, textarea {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
  width: 100%;
}
input::placeholder, textarea::placeholder {
  color: var(--faint);
}
input:focus, textarea:focus {
  border-color: var(--teal);
}

/* 空态 */
.empty {
  text-align: center;
  color: var(--muted);
  padding: 100rpx 52rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.empty .empty-title {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 650;
  color: var(--ink);
  margin: 30rpx 28rpx 18rpx;
}